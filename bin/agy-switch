#!/usr/bin/env bash
# ==============================================================================
# agy-switch: Fast Multi-Account Profile & Session Manager for Antigravity CLI
# ==============================================================================
set -e

PROFILES_DIR="$HOME/.gemini-profiles"
GEMINI_DIR="$HOME/.gemini"
TARGET_DIR="$GEMINI_DIR/antigravity-cli"
CURRENT_FILE="$PROFILES_DIR/.current"
SHARED_DIR="$HOME/.gemini-shared/antigravity-cli"
SESSION_MODE_FILE="$PROFILES_DIR/.session_mode"

mkdir -p "$PROFILES_DIR" "$GEMINI_DIR"

# 获取当前会话共享模式 (shared | isolated, 默认 isolated)
get_session_mode() {
    if [ -f "$SESSION_MODE_FILE" ]; then
        cat "$SESSION_MODE_FILE"
    else
        echo "isolated"
    fi
}

# 获取当前 active profile 名称
get_current() {
    if [ -f "$CURRENT_FILE" ] && [ -n "$(cat "$CURRENT_FILE" 2>/dev/null)" ]; then
        cat "$CURRENT_FILE"
    elif [ -L "$TARGET_DIR" ]; then
        local real_target
        real_target=$(readlink -f "$TARGET_DIR" 2>/dev/null || true)
        if [ -n "$real_target" ]; then
            basename "$(dirname "$real_target")"
        else
            echo "none"
        fi
    else
        echo "none"
    fi
}

# 原子切换软链接
set_symlink() {
    local target_profile_dir="$1"
    local tmp_link="$TARGET_DIR.tmp.$$"
    mkdir -p "$target_profile_dir"
    ln -sfn "$target_profile_dir" "$tmp_link"
    mv -Tf "$tmp_link" "$TARGET_DIR"
}

# 应用 session 共享/隔离设置到特定 profile
apply_session_mode_to_profile() {
    local prof_dir="$1"
    local mode="$2"
    [ -d "$prof_dir" ] || return 0

    local session_items=("conversations" "brain" "history.jsonl" "conversation_summaries.db" "conversation_summaries.db-shm" "conversation_summaries.db-wal")

    if [ "$mode" = "shared" ]; then
        mkdir -p "$SHARED_DIR"
        for item in "${session_items[@]}"; do
            local src="$prof_dir/$item"
            local dst="$SHARED_DIR/$item"
            # 如果目标共享区不存在，且本地存在非软链接实体，先迁移过去
            if [ ! -e "$dst" ] && [ -e "$src" ] && [ ! -L "$src" ]; then
                mv "$src" "$dst"
            fi
            # 建立软链接
            if [ -e "$dst" ]; then
                rm -rf "$src"
                ln -sfn "$dst" "$src"
            fi
        done
    else
        # 隔离模式：将共享区内容解绑复制回本地
        for item in "${session_items[@]}"; do
            local src="$prof_dir/$item"
            local dst="$SHARED_DIR/$item"
            if [ -L "$src" ]; then
                rm -f "$src"
                if [ -e "$dst" ]; then
                    cp -a "$dst" "$src"
                fi
            fi
        done
    fi
}

# 初次运行时，若 antigravity-cli 为实体目录则安全迁移至 default profile
ensure_init() {
    if [ -d "$TARGET_DIR" ] && [ ! -L "$TARGET_DIR" ]; then
        echo -e "\033[1;33m💡 检测到现有登录凭据，正在自动安全迁移至 [default] Profile...\033[0m"
        mkdir -p "$PROFILES_DIR/default"
        mv "$TARGET_DIR" "$PROFILES_DIR/default/antigravity-cli"
        set_symlink "$PROFILES_DIR/default/antigravity-cli"
        echo "default" > "$CURRENT_FILE"
        echo "isolated" > "$SESSION_MODE_FILE"
        echo -e "\033[1;32m✅ 初始迁移完成！当前默认 Profile 为: default\033[0m"
    fi
}

ensure_init

cmd="${1:-list}"
name="${2}"
extra="${3}"

case "$cmd" in
    list|ls)
        curr=$(get_current)
        smode=$(get_session_mode)
        echo -e "\033[1;36m📋 Antigravity CLI 账号 Profiles:\033[0m"
        found=0
        for d in "$PROFILES_DIR"/*/; do
            [ -d "$d" ] || continue
            p=$(basename "$d")
            found=1
            if [ "$p" = "$curr" ]; then
                echo -e "  \033[1;32m👉 $p (当前活动)\033[0m"
            else
                echo -e "     $p"
            fi
        done
        if [ $found -eq 0 ]; then
            echo "   (暂无保存的 Profile，请使用 'agy-switch save <name>' 或 'agy-switch new <name>')"
        fi
        echo ""
        if [ "$smode" = "shared" ]; then
            echo -e "💬 Session 模式: \033[1;32m共享 (Shared)\033[0m - 切换账号时保留对话历史与上下文"
        else
            echo -e "💬 Session 模式: \033[1;33m独立 (Isolated)\033[0m - 每个账号拥有独立的对话历史"
        fi
        ;;

    save)
        if [ -z "$name" ]; then
            echo -e "\033[1;31m❌ 用法: agy-switch save <profile_name>\033[0m"
            exit 1
        fi
        mkdir -p "$PROFILES_DIR/$name"
        if [ -L "$TARGET_DIR" ]; then
            real_path=$(readlink -f "$TARGET_DIR")
            if [ "$real_path" != "$PROFILES_DIR/$name/antigravity-cli" ]; then
                rm -rf "$PROFILES_DIR/$name/antigravity-cli"
                cp -a "$real_path" "$PROFILES_DIR/$name/antigravity-cli"
            fi
        elif [ -d "$TARGET_DIR" ]; then
            rm -rf "$PROFILES_DIR/$name/antigravity-cli"
            cp -a "$TARGET_DIR" "$PROFILES_DIR/$name/antigravity-cli"
        else
            mkdir -p "$PROFILES_DIR/$name/antigravity-cli"
        fi
        apply_session_mode_to_profile "$PROFILES_DIR/$name/antigravity-cli" "$(get_session_mode)"
        set_symlink "$PROFILES_DIR/$name/antigravity-cli"
        echo "$name" > "$CURRENT_FILE"
        echo -e "\033[1;32m✅ 已将当前登录状态保存并锁定到 Profile: $name\033[0m"
        ;;

    use|switch)
        if [ -z "$name" ]; then
            echo -e "\033[1;31m❌ 用法: agy-switch use <profile_name>\033[0m"
            exit 1
        fi
        if [ ! -d "$PROFILES_DIR/$name/antigravity-cli" ] && [ ! -d "$PROFILES_DIR/$name" ]; then
            echo -e "\033[1;31m❌ 找不到 Profile [$name]！可用列表：\033[0m"
            $0 list
            exit 1
        fi
        apply_session_mode_to_profile "$PROFILES_DIR/$name/antigravity-cli" "$(get_session_mode)"
        set_symlink "$PROFILES_DIR/$name/antigravity-cli"
        echo "$name" > "$CURRENT_FILE"
        echo -e "\033[1;32m🎉 已成功切换到账号 Profile: $name\033[0m"
        echo -e "\033[0;37m提示: 重新打开终端或直接运行 agy 即可使用此账号。\033[0m"
        ;;

    new)
        if [ -z "$name" ]; then
            echo -e "\033[1;31m❌ 用法: agy-switch new <profile_name>\033[0m"
            exit 1
        fi
        if [ -d "$PROFILES_DIR/$name" ]; then
            echo -e "\033[1;33m⚠️  Profile [$name] 已存在！如需切换请用: agy-switch use $name\033[0m"
            exit 1
        fi
        mkdir -p "$PROFILES_DIR/$name/antigravity-cli"
        apply_session_mode_to_profile "$PROFILES_DIR/$name/antigravity-cli" "$(get_session_mode)"
        set_symlink "$PROFILES_DIR/$name/antigravity-cli"
        echo "$name" > "$CURRENT_FILE"
        echo -e "\033[1;32m✨ 已创建并切换到全新空白 Profile: $name\033[0m"
        echo -e "\033[1;34m👉 现在运行 agy 即可登录你的新账号（登录后凭据会自动持久化保存在此 Profile 下）。\033[0m"
        ;;

    rename|mv)
        if [ -z "$name" ] || [ -z "$extra" ]; then
            echo -e "\033[1;31m❌ 用法: agy-switch rename <old_name> <new_name>\033[0m"
            exit 1
        fi
        if [ ! -d "$PROFILES_DIR/$name" ]; then
            echo -e "\033[1;31m❌ 找不到旧 Profile [$name]！\033[0m"
            exit 1
        fi
        if [ -d "$PROFILES_DIR/$extra" ]; then
            echo -e "\033[1;31m❌ 目标名称 [$extra] 已存在！\033[0m"
            exit 1
        fi
        curr=$(get_current)
        mv "$PROFILES_DIR/$name" "$PROFILES_DIR/$extra"
        if [ "$curr" = "$name" ]; then
            set_symlink "$PROFILES_DIR/$extra/antigravity-cli"
            echo "$extra" > "$CURRENT_FILE"
        fi
        echo -e "\033[1;32m✅ 已成功将 Profile [$name] 重命名为 [$extra]\033[0m"
        ;;

    delete|rm)
        if [ -z "$name" ]; then
            echo -e "\033[1;31m❌ 用法: agy-switch delete <profile_name>\033[0m"
            exit 1
        fi
        curr=$(get_current)
        if [ "$name" = "$curr" ]; then
            echo -e "\033[1;31m❌ 不能删除当前正在活动的 Profile [$name]！请先切换到其他 Profile 后再删除。\033[0m"
            exit 1
        fi
        if [ ! -d "$PROFILES_DIR/$name" ]; then
            echo -e "\033[1;31m❌ 找不到 Profile [$name]！\033[0m"
            exit 1
        fi
        rm -rf "$PROFILES_DIR/$name"
        echo -e "\033[1;32m🗑️  已成功删除 Profile: $name\033[0m"
        ;;

    whoami|current)
        echo -e "当前活动 Profile: \033[1;32m$(get_current)\033[0m"
        ;;

    session)
        sub="${name}"
        case "$sub" in
            share)
                echo "shared" > "$SESSION_MODE_FILE"
                echo -e "\033[1;33m🔄 正在将现有 Profiles 的会话数据统一并开启共享...\033[0m"
                for d in "$PROFILES_DIR"/*/; do
                    [ -d "$d" ] || continue
                    apply_session_mode_to_profile "$d/antigravity-cli" "shared"
                done
                echo -e "\033[1;32m✅ 会话共享已开启！所有账号将共享聊天历史记录与上下文（切换账号后可直接 agy -c 继承会话）。\033[0m"
                ;;
            isolate)
                echo "isolated" > "$SESSION_MODE_FILE"
                echo -e "\033[1;33m🔄 正在将共享会话数据独立分发至各 Profile 并开启隔离...\033[0m"
                for d in "$PROFILES_DIR"/*/; do
                    [ -d "$d" ] || continue
                    apply_session_mode_to_profile "$d/antigravity-cli" "isolated"
                done
                echo -e "\033[1;32m✅ 会话隔离已开启！每个账号将保持独立的会话与历史记录。\033[0m"
                ;;
            status|"")
                smode=$(get_session_mode)
                echo -e "当前 Session 模式: \033[1;36m$smode\033[0m"
                if [ "$smode" = "shared" ]; then
                    echo "说明: 共享模式 (Shared) - 切换账号时保留对话历史与上下文。"
                else
                    echo "说明: 独立模式 (Isolated) - 每个账号拥有独立的对话历史。"
                fi
                echo ""
                echo "切换模式命令:"
                echo "  agy-switch session share    开启会话共享 (session 不隔离)"
                echo "  agy-switch session isolate  开启会话隔离 (session 隔离)"
                ;;
            *)
                echo -e "\033[1;31m❌ 未知 session 子命令: $sub\033[0m"
                echo "用法: agy-switch session [share | isolate | status]"
                exit 1
                ;;
        esac
        ;;

    usage|quota|stats)
        target_profile="${name}"
        python3 - << 'PYEOF' "$PROFILES_DIR" "$CURRENT_FILE" "$target_profile"
import sys, os, re, json, shutil, urllib.request, urllib.parse, sqlite3, glob, datetime

profiles_dir = sys.argv[1]
current_file = sys.argv[2]
target_arg = sys.argv[3] if len(sys.argv) > 3 else ""

current_prof = "default"
if os.path.exists(current_file):
    try:
        with open(current_file) as f:
            current_prof = f.read().strip()
    except Exception:
        pass

def format_progress_bar(frac, width=12):
    pct = frac * 100.0
    filled = int(round(frac * width))
    bar = "█" * filled + "░" * (width - filled)
    if pct > 60:
        color = "\033[1;32m" # green
    elif pct > 20:
        color = "\033[1;33m" # yellow
    else:
        color = "\033[1;31m" # red
    return f"{color}[{bar}]\033[0m {pct:5.1f}%"

def format_reset_time(reset_str):
    if not reset_str:
        return "充足"
    try:
        if reset_str.endswith("Z"):
            reset_str = reset_str[:-1] + "+00:00"
        dt = datetime.datetime.fromisoformat(reset_str)
        now = datetime.datetime.now(datetime.timezone.utc)
        diff = dt - now
        total_sec = int(diff.total_seconds())
        if total_sec <= 0:
            return "即将刷新"
        days = total_sec // 86400
        hours = (total_sec % 86400) // 3600
        mins = (total_sec % 3600) // 60
        if days > 0:
            return f"重置: {days}d {hours}h"
        elif hours > 0:
            return f"重置: {hours}h {mins}m"
        else:
            return f"重置: {mins}m"
    except Exception:
        return "重置中"

def extract_oauth_pairs():
    agy_bin = shutil.which("agy") or os.path.expanduser("~/.local/bin/agy")
    if not agy_bin or not os.path.exists(agy_bin):
        return []
    try:
        with open(agy_bin, "rb") as f:
            content = f.read()
        cids = [m.decode() for m in set(re.findall(rb"([0-9]+-[a-zA-Z0-9_]+\.apps\.googleusercontent\.com)", content))]
        secrets = [s.decode() for s in set(re.findall(rb"GOCSPX-[a-zA-Z0-9_-]{28}", content))]
        pairs = []
        for c in cids:
            for s in secrets:
                pairs.append((c, s))
            pairs.append((c, None))
        return pairs
    except Exception:
        return []

def get_or_refresh_token(token_path):
    if not os.path.exists(token_path):
        return None, None, "未找到 Token 文件"
    try:
        with open(token_path, "r") as f:
            tdata = json.load(f)
    except Exception as e:
        return None, None, f"Token 解析失败: {e}"

    token_obj = tdata.get("token", {})
    access_token = token_obj.get("access_token")
    refresh_token = token_obj.get("refresh_token")

    # 1. 尝试直接验证 access_token
    if access_token:
        try:
            req = urllib.request.Request(f"https://oauth2.googleapis.com/tokeninfo?access_token={access_token}")
            with urllib.request.urlopen(req, timeout=3) as resp:
                info = json.loads(resp.read().decode())
                exp_sec = int(info.get("expires_in", 0))
                if exp_sec > 0:
                    return access_token, info, None
        except Exception:
            pass # 过期或失效，进入自动刷新流程

    # 2. 若 access_token 过期，使用 refresh_token 自动刷新
    if refresh_token:
        pairs = extract_oauth_pairs()
        for cid, csec in pairs:
            try:
                data = {
                    "client_id": cid,
                    "grant_type": "refresh_token",
                    "refresh_token": refresh_token
                }
                if csec:
                    data["client_secret"] = csec
                encoded = urllib.parse.urlencode(data).encode("utf-8")
                req = urllib.request.Request("https://oauth2.googleapis.com/token", data=encoded, headers={"Content-Type": "application/x-www-form-urlencoded"})
                with urllib.request.urlopen(req, timeout=4) as resp:
                    res = json.loads(resp.read().decode())
                    new_access_token = res.get("access_token")
                    expires_in = res.get("expires_in", 3600)

                    # 更新 token 文件
                    token_obj["access_token"] = new_access_token
                    now_utc = datetime.datetime.now(datetime.timezone.utc)
                    exp_time = now_utc + datetime.timedelta(seconds=expires_in)
                    token_obj["expiry"] = exp_time.isoformat()
                    tdata["token"] = token_obj

                    try:
                        with open(token_path, "w") as f:
                            json.dump(tdata, f, indent=2)
                    except Exception:
                        pass

                    # 获取最新 tokeninfo
                    req_info = urllib.request.Request(f"https://oauth2.googleapis.com/tokeninfo?access_token={new_access_token}")
                    with urllib.request.urlopen(req_info, timeout=3) as resp_info:
                        info = json.loads(resp_info.read().decode())
                        return new_access_token, info, None
            except Exception:
                continue

        return None, None, "Token 自动刷新失败，请重新登录该账号"

    return None, None, "Token 已过期且无可用 refresh_token"

def inspect_profile(pname):
    base = os.path.join(profiles_dir, pname, "antigravity-cli")
    if not os.path.exists(base):
        return None
    res = {
        "profile": pname,
        "is_current": (pname == current_prof),
        "email": "未登录/未获取",
        "name": "-",
        "token_status": "无 Token",
        "expires_in": "-",
        "tier": "Free",
        "quota_groups": [],
        "conversations": 0,
        "history_lines": 0
    }
    
    # 统计 DB
    db_path = os.path.join(base, "conversation_summaries.db")
    if os.path.exists(db_path):
        try:
            conn = sqlite3.connect(db_path)
            c = conn.cursor()
            res["conversations"] = c.execute("SELECT COUNT(*) FROM conversation_summaries;").fetchone()[0]
        except Exception:
            pass
            
    # 统计 history
    hist_path = os.path.join(base, "history.jsonl")
    if os.path.exists(hist_path):
        try:
            with open(hist_path) as f:
                res["history_lines"] = sum(1 for _ in f)
        except Exception:
            pass

    # Token 详情与自动刷新
    token_path = os.path.join(base, "antigravity-oauth-token")
    access_token, token_info, err = get_or_refresh_token(token_path)

    if access_token and token_info:
        res["email"] = token_info.get("email", res["email"])
        exp_sec = int(token_info.get("expires_in", 0))
        if exp_sec > 0:
            res["token_status"] = "有效"
            res["expires_in"] = f"{exp_sec // 60}m {exp_sec % 60}s"
        else:
            res["token_status"] = "已过期"
            res["expires_in"] = "已过期"

        # UserInfo (姓名)
        try:
            req = urllib.request.Request("https://www.googleapis.com/oauth2/v3/userinfo", headers={"Authorization": f"Bearer {access_token}"})
            with urllib.request.urlopen(req, timeout=3) as resp:
                uinfo = json.loads(resp.read().decode())
                res["name"] = uinfo.get("name", res["name"])
        except Exception:
            pass

        # CodeAssist Tier (Plan: Free / Plus / Pro / Ultra / Enterprise)
        try:
            req = urllib.request.Request(
                "https://cloudcode-pa.googleapis.com/v1internal:loadCodeAssist",
                data=json.dumps({}).encode("utf-8"),
                headers={"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}
            )
            with urllib.request.urlopen(req, timeout=3) as resp:
                ca = json.loads(resp.read().decode())
                cur_tier = ca.get("currentTier", {})
                tid = cur_tier.get("id", "").lower()
                tname = cur_tier.get("name", "")
                if "free" in tid:
                    res["tier"] = "Free"
                elif "ultra" in tid:
                    res["tier"] = "Ultra"
                elif "pro" in tid:
                    res["tier"] = "Pro"
                elif "plus" in tid:
                    res["tier"] = "Plus"
                elif "standard" in tid:
                    res["tier"] = "Standard (GCP)"
                elif "enterprise" in tid:
                    res["tier"] = "Enterprise"
                elif tname:
                    res["tier"] = tname
        except Exception:
            pass

        # Quota Summary (周配额 / 5小时配额)
        try:
            req = urllib.request.Request(
                "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
                data=json.dumps({}).encode("utf-8"),
                headers={"Authorization": f"Bearer {access_token}", "Content-Type": "application/json", "User-Agent": "Antigravity"}
            )
            with urllib.request.urlopen(req, timeout=4) as resp:
                qdata = json.loads(resp.read().decode())
                for g in qdata.get("groups", []):
                    gname = g.get("displayName", "Model Group")
                    b_list = []
                    for b in g.get("buckets", []):
                        dname = b.get("displayName", "Limit")
                        short_name = "周配额" if "week" in dname.lower() else ("5h配额" if "five" in dname.lower() or "5h" in dname.lower() else dname)
                        frac = b.get("remainingFraction", 1.0)
                        reset_str = b.get("resetTime")
                        reset_fmt = format_reset_time(reset_str) if frac < 0.999 else "充足"
                        b_list.append((short_name, frac, reset_fmt))
                    res["quota_groups"].append((gname, b_list))
        except Exception:
            pass
    else:
        res["token_status"] = err or "需重新登录"

    return res

if target_arg in ["all", "--all", "-a"]:
    pnames = [os.path.basename(os.path.dirname(d)) for d in glob.glob(os.path.join(profiles_dir, "*/"))]
else:
    pnames = [target_arg] if target_arg else [current_prof]

results = [inspect_profile(p) for p in pnames if inspect_profile(p)]

if not results:
    print(f"\033[1;31m❌ 未找到指定的 Profile 信息: {target_arg}\033[0m")
    sys.exit(1)

print("\033[1;36m📊 Antigravity 账号 Usage & 配额状态报表:\033[0m\n")
for r in results:
    active_tag = " \033[1;32m[当前活动]\033[0m" if r["is_current"] else ""
    tier_color = "\033[1;32m" if r["tier"] in ["Pro", "Ultra", "Enterprise"] else "\033[1;34m"
    print(f"\033[1;35m━━━ Profile: {r['profile']}{active_tag} ━━━\033[0m")
    print(f"  👤 用户: \033[1;37m{r['name']}\033[0m ({r['email']})  |  💎 订阅: {tier_color}{r['tier']}\033[0m  |  🔑 Token: {r['token_status']} ({r['expires_in']})")
    print(f"  💬 会话: {r['conversations']} 个会话 / {r['history_lines']} 条交互记录")
    
    if r["quota_groups"]:
        print()
        for gname, blist in r["quota_groups"]:
            # 图标
            icon = "🤖" if "gemini" in gname.lower() else "🧠"
            print(f"  {icon} \033[1;33m{gname}\033[0m:")
            for sname, frac, rfmt in blist:
                bar_str = format_progress_bar(frac, 12)
                print(f"     {sname:5s}: {bar_str} ({rfmt})")
    print()
PYEOF
        ;;

    *)
        if [ -d "$PROFILES_DIR/$cmd/antigravity-cli" ] || [ -d "$PROFILES_DIR/$cmd" ]; then
            $0 use "$cmd"
        else
            echo -e "\033[1;36mAntigravity CLI (agy) 多账号与 Session 管理工具\033[0m"
            echo "用法:"
            echo "  agy-switch list                     列出所有账号 Profiles"
            echo "  agy-switch save <name>              将当前登录凭据保存为指定名称"
            echo "  agy-switch new <name>               创建全新账号 Profile 并准备登录"
            echo "  agy-switch use <name>               切换到指定账号 (支持直接: agy-switch <name>)"
            echo "  agy-switch rename <old> <new>       重命名 Profile"
            echo "  agy-switch delete <name>            删除指定 Profile"
            echo "  agy-switch whoami                   查看当前活动的账号 Profile"
            echo "  agy-switch session <share|isolate>  配置会话共享(不隔离)或独立隔离"
            echo "  agy-switch usage [profile|all]      查询当前或所有账号的 Token/订阅/配额进度"
        fi
        ;;
esac
